# Hoaxlin local Docker environment.
# The setup scripts generate blank local secrets in .env and never overwrite
# an existing non-empty value.

APP_NAME="hoaxlin.id"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_HOST_PORT=8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

# Docker-internal MySQL connection. The application account must not be root.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hoax_detector
MYSQL_APP_USER=hoaxlin
DB_USERNAME=hoaxlin
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Redis is internal-only and backs cache, sessions, and queues.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_RETRY_AFTER=240
REDIS_MEDIA_RETRY_AFTER=1800
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
MEDIA_DISK=local

# Internal, offline BERT service. The token is generated locally by setup.
BERT_SERVICE_URL=http://bert:8001
BERT_SERVICE_TOKEN=
BERT_MODEL_VERSION=v1.0.0
BERT_CONFIDENCE_THRESHOLD=0.99
BERT_SERVICE_CONNECT_TIMEOUT=3
BERT_SERVICE_TIMEOUT=30
BERT_SERVICE_TRIES=5
BERT_BREAKER_FAILURES=5
BERT_BREAKER_WINDOW=60
BERT_BREAKER_COOLDOWN=30
BERT_CACHE_TTL=604800

# Optional. Infrastructure boots without this, but OCR, transcription,
# translation, and explanation features require a user-provided key.
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_PROMPT_VERSION=1.0
OPENAI_TRANSLATION_MAX_OUTPUT_TOKENS=4096
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_CONNECT_TIMEOUT=5
OPENAI_TIMEOUT=45
OPENAI_TRIES=3
OPENAI_BREAKER_FAILURES=5
OPENAI_BREAKER_WINDOW=60
OPENAI_BREAKER_COOLDOWN=60
OPENAI_CACHE_TTL=2592000
OPENAI_RATE_LIMIT_PER_MINUTE=60
OPENAI_MONTHLY_QUOTA_USD=25.0
OPENAI_PROMPT_VERSION=1.0

# Default mail is logged to container stderr; Gmail SMTP is optional.
# For Gmail, use smtp.gmail.com:587 and a Google App Password in private .env.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_URL=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
