APP_NAME="hoaxlin.id"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hoax_detector
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# D5: For S3-compatible private media (multi-instance), set MEDIA_DISK=s3 or FILESYSTEM_DISK=s3
# and configure AWS_* below. Local dev keeps local.
MEDIA_DISK=
QUEUE_CONNECTION=database
# Production recommendation: QUEUE_CONNECTION=redis and CACHE_STORE=redis.
REDIS_MEDIA_RETRY_AFTER=1800

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_BUCKET_ENDPOINT=false
AWS_VISIBILITY=private

VITE_APP_NAME="${APP_NAME}"

# Internal FastAPI service hosting the fine-tuned Indonesian BERT model.
BERT_SERVICE_URL=http://127.0.0.1:8001
BERT_SERVICE_TIMEOUT=30
BERT_SERVICE_CONNECT_TIMEOUT=3
BERT_SERVICE_TOKEN=
BERT_SERVICE_TRIES=5
BERT_MODEL_VERSION=unknown
BERT_BREAKER_FAILURES=8
BERT_BREAKER_WINDOW=120
BERT_BREAKER_COOLDOWN=10
BERT_CACHE_TTL=604800
BERT_CONFIDENCE_THRESHOLD=0.99

# Used for English-to-Indonesian translation, OCR, transcription, and user-facing explanations.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_PROMPT_VERSION=1.0
OPENAI_TRANSLATION_MAX_OUTPUT_TOKENS=4096
OPENAI_CONNECT_TIMEOUT=5
OPENAI_TIMEOUT=45
OPENAI_TRIES=3
OPENAI_CACHE_TTL=2592000
OPENAI_PROMPT_VERSION=1.0
