* text=auto eol=lf

# Challenge CSV record separators are canonical LF; historical CRLF identity
# remains explicit in the versioned manifest (do not regenerate frozen rows).
/datasets/challenge/**/*.csv text eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
